SECRET_KEY=change-me-generate-with-django-get-random-secret-key
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com,.up.railway.app
CSRF_TRUSTED_ORIGINS=https://*.onrender.com,https://*.up.railway.app

# Postgres in production; omit for local sqlite
DATABASE_URL=

# Pipeline knobs (safe defaults if unset)
MAX_UPLOAD_MB=500
MAX_UPLOAD_MINUTES=30
PIPELINE_SAMPLE_FPS=2

# Phase 4 — Celery worker (falls back to in-process thread runner if unset)
CELERY_BROKER_URL=
USE_CELERY=False

# Phase 3 — optional LLM hook picker (falls back to keyword heuristic if unset)
OPENAI_API_KEY=
